                    <div class="company-info">
                        <h4>Company Details</h4>
                        <div class="info-grid">
                            <div class="info-item">
                                <span class="info-label">Company Name:</span>
                                <span class="info-value">EXA ENERGY SDN. BHD.</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Registration No.:</span>
                                <span class="info-value">1553765 – K</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Date of Registration:</span>
                                <span class="info-value">28th February 2024</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Banker Name:</span>
                                <span class="info-value">MAYBANK ISLAMIC BERHAD</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Account No.:</span>
                                <span class="info-value">5541 0152 8193</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Branch:</span>
                                <span class="info-value">Masjid Tanah, Melaka</span>
                            </div>
                        </div>
                    </div>
